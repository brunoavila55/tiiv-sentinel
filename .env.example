# Copie para .env e ajuste. `docker compose up -d` sobe tudo a partir daqui.

APP_ENV=production

# Postgres
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sentinel
POSTGRES_PORT=5432

# MinIO
MINIO_ACCESS_KEY=sentinel
MINIO_SECRET_KEY=troque-esta-senha-tambem
MINIO_BUCKET=sentinel
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# ATENCAO: este e o endereco que o NAVEGADOR usa para baixar/subir arquivo.
# Em uma VM real: http://IP-DA-VM:9000 ou https://storage.seudominio.com.br
# Deixar http://minio:9000 aqui gera URL que so funciona dentro do container.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_PRESIGN_TTL=15m

# Sessao / admin inicial (criado no primeiro boot, se nao houver usuarios)
SESSION_TTL=720h
COOKIE_SECURE=false          # true quando servir por HTTPS
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=troque-esta-senha

# Anexos
MAX_UPLOAD_BYTES=52428800    # 50MB

# Poller ICMP (status, nada de historico)
POLL_ENABLED=true
POLL_INTERVAL=60s
POLL_CONCURRENCY=50
POLL_TIMEOUT=3s
PING_PRIVILEGED=false        # false usa ICMP nao privilegiado (sysctl do compose)

# Frontend
WEB_PORT=8080
API_PORT=8081

# Opcional: aponte para um kind-templates.json externo (montado no container)
# para ajustar os atributos sugeridos por tipo sem recompilar. Sem isso usa o
# embutido em internal/config/kind-templates.default.json.
# KIND_TEMPLATES_FILE=/etc/sentinel/kind-templates.json
